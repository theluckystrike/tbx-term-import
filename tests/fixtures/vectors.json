    {
      "name": "English and French labels",
      "args": [
        {
          "op": "read",
          "xml": "<martif><text><body><termEntry id=\"c1\"><langSet xml:lang=\"en\"><tig><term>pump</term></tig></langSet><langSet xml:lang=\"fr\"><tig><term>pompe</term></tig></langSet></termEntry></body></text></martif>",
          "source": "en",
          "target": "fr"
        }
      ],
      "expected": {
        "version": 1,
        "source": "en",
        "target": "fr",
        "rows": [
          {
            "id": "c1",
            "source": [
              "pump"
            ],
            "target": [
              "pompe"
            ],
            "definitions": [],
            "missing": []
          }
        ],
        "skipped": [],
        "warnings": []
      }
    },
